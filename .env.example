# ===============================================
# PlaylistBridge Environment Configuration (.env.example)
# ===============================================

# Spotify OAuth 2.0 Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Google / YouTube OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/youtube/callback

# Amazon / Login with Amazon (LWA) OAuth 2.0 Credentials (https://developer.amazon.com/loginwithamazon)
AMAZON_CLIENT_ID=your_amazon_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_REDIRECT_URI=http://127.0.0.1:3000/api/auth/amazon/callback

# JioSaavn / Jio SSO OAuth 2.0 Credentials (https://developer.jiosaavn.com or Jio Partner Portal)
JIOSAAVN_CLIENT_ID=your_jiosaavn_client_id_here
JIOSAAVN_CLIENT_SECRET=your_jiosaavn_client_secret_here
JIOSAAVN_REDIRECT_URI=http://127.0.0.1:3000/api/auth/jiosaavn/callback

# Session Secret (32+ character random string for AES-256 encrypted session cookies)
SESSION_SECRET=your_32_character_random_secret_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live OAuth is active (set to false for demo mode with mock data)
NEXT_PUBLIC_DEFAULT_DEMO_MODE=false
